# ===================================================
# Backend Environment Variables (Railway / Local)
# ===================================================

# Database Configuration
# Local SQLite: sqlite:///./meetings.db
# Production Railway (Persistent Volume mounted at /data): sqlite:////data/meetings.db
DATABASE_URL=sqlite:///./meetings.db

# LiveKit SFU Realtime Video
# Local Dev Server: ws://127.0.0.1:7880
# Production LiveKit Cloud: wss://<your-project-subdomain>.livekit.cloud
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# CORS Configuration
# Allowed origins for frontend requests (comma-separated, NO trailing slash, NO wildcard "*" in production)
# Local Dev: http://localhost:3000
# Production: https://<your-frontend-project>.vercel.app
FRONTEND_URL=http://localhost:3000
